              {"s": "FOREXCOM:NSXUSD", "d": "NASDAQ 100 (tech-heavy index)"}
            ],
            "originalTitle": "Stocks"
          }
        ]
      }
      </script>
    </div>
  </div>

  <!-- BOND YIELDS -->
  <div class="section-title">Bond Yields</div>
  <p class="explainer">
    When yields rise, the value of bonds you own falls — and stocks come under pressure too. The 10-year and 30-year yields are the most important to watch. These charts update daily from the Federal Reserve.
  </p>
  <div class="fred-grid" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));">

    <div class="fred-card">
      <h3>10-Year Treasury Yield</h3>
      <div class="fred-subtitle">The most-watched rate in the world. Drives mortgage rates, stock valuations, and borrowing costs. Currently elevated at 4.59%.</div>
      <img src="https://fred.stlouisfed.org/graph/fredgraph.png?id=DGS10&cosd=2022-01-01&width=460&height=220&bgcolor=%23ffffff&graph_bgcolor=%23ffffff&fo=Open%20Sans&ts=11&tts=11&line_color=%23e53e3e" alt="10-Year Treasury Yield" loading="lazy">
      <a href="https://fred.stlouisfed.org/series/DGS10" target="_blank">View full chart on FRED</a>
    </div>

    <div class="fred-card">
      <h3>30-Year Treasury Yield</h3>
      <div class="fred-subtitle">Crossed 5.12% this week — a multi-year high. Reflects long-term inflation expectations. Bond values fall when this rises.</div>
      <img src="https://fred.stlouisfed.org/graph/fredgraph.png?id=DGS30&cosd=2022-01-01&width=460&height=220&bgcolor=%23ffffff&graph_bgcolor=%23ffffff&fo=Open%20Sans&ts=11&tts=11&line_color=%23e53e3e" alt="30-Year Treasury Yield" loading="lazy">
      <a href="https://fred.stlouisfed.org/series/DGS30" target="_blank">View full chart on FRED</a>
    </div>

    <div class="fred-card">
      <h3>2-Year Treasury Yield</h3>
      <div class="fred-subtitle">Tracks near-term Fed rate expectations most closely. When this is higher than the 10-year yield, it signals a recession may be coming.</div>
      <img src="https://fred.stlouisfed.org/graph/fredgraph.png?id=DGS2&cosd=2022-01-01&width=460&height=220&bgcolor=%23ffffff&graph_bgcolor=%23ffffff&fo=Open%20Sans&ts=11&tts=11&line_color=%23d69e2e" alt="2-Year Treasury Yield" loading="lazy">
      <a href="https://fred.stlouisfed.org/series/DGS2" target="_blank">View full chart on FRED</a>
    </div>

  </div>

  <!-- COMMODITIES -->
  <div class="section-title">Commodities</div>
  <p class="explainer">
    Commodities are raw materials that feed into the prices of almost everything else. Oil affects transportation and manufacturing costs. Natural gas affects heating and electricity bills. Wheat and corn affect food prices. Gold is a traditional "store of value" investors buy when nervous. Rising commodity prices usually feed into inflation.
  </p>
  <div class="widget-box">
    <div class="tradingview-widget-container" style="height:500px">
      <div class="tradingview-widget-container__widget"></div>
      <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-market-overview.js" async>
      {
        "colorTheme": "light",
        "dateRange": "3M",
        "showChart": true,
        "locale": "en",
        "width": "100%",
        "height": 500,
        "isTransparent": false,
        "showSymbolLogo": false,
        "showFloatingTooltip": false,
        "plotLineColorGrowing": "rgba(41, 98, 255, 1.0)",
        "plotLineColorFalling": "rgba(220, 50, 50, 1.0)",
        "gridLineColor": "rgba(240, 243, 250, 0)",
        "scaleFontColor": "rgba(106, 109, 120, 1.0)",
        "belowLineFillColorGrowing": "rgba(41, 98, 255, 0.08)",
        "belowLineFillColorFalling": "rgba(220, 50, 50, 0.08)",
        "belowLineFillColorGrowingBottom": "rgba(41, 98, 255, 0)",
        "belowLineFillColorFallingBottom": "rgba(220, 50, 50, 0)",
        "symbolActiveColor": "rgba(41, 98, 255, 0.12)",
        "tabs": [
          {
            "title": "Energy",
            "symbols": [
              {"s": "TVC:USOIL", "d": "WTI Crude Oil (US benchmark, per barrel)"},
              {"s": "TVC:UKOIL", "d": "Brent Crude (global benchmark, per barrel)"},
              {"s": "TVC:NATGAS", "d": "Natural Gas (per million BTU)"}
            ],
            "originalTitle": "Energy"
          },
          {
            "title": "Agriculture",
            "symbols": [
              {"s": "AMEX:WEAT", "d": "Wheat ETF — tracks wheat price (bread, pasta)"},
              {"s": "AMEX:CORN", "d": "Corn ETF — tracks corn price (food, fuel, feed)"},
              {"s": "AMEX:SOYB", "d": "Soybean ETF — tracks soy price (food, animal feed)"}
            ],
            "originalTitle": "Agriculture"
          },
          {
            "title": "Metals",
            "symbols": [
              {"s": "TVC:GOLD", "d": "Gold (safe-haven, tracks uncertainty)"},
              {"s": "TVC:SILVER", "d": "Silver (industrial and safe-haven)"},
              {"s": "COMEX:HG1!", "d": "Copper (tracks global economic activity)"}
            ],
            "originalTitle": "Metals"
          }
        ]
      }
      </script>
    </div>
  </div>

  <!-- MACRO INDICATORS -->
  <div class="section-title">Key Economic Indicators (Federal Reserve Data)</div>
  <p class="explainer">
    These charts come directly from the Federal Reserve and update automatically when new data is released. They are published monthly or quarterly — not daily — so they show trends rather than daily moves. CPI and the unemployment rate are the two the Fed watches most closely when deciding whether to raise or lower interest rates.
  </p>

  <div class="fred-grid">

    <div class="fred-card">
      <h3>Inflation (CPI)</h3>
      <div class="fred-subtitle">Consumer Price Index — how fast prices are rising. Above 2% means the Fed is watching closely.</div>
      <img src="https://fred.stlouisfed.org/graph/fredgraph.png?id=CPIAUCSL&cosd=2020-01-01&width=400&height=220&bgcolor=%23ffffff&graph_bgcolor=%23ffffff&fo=Open%20Sans&ts=11&tts=11" alt="CPI Chart" loading="lazy">
      <a href="https://fred.stlouisfed.org/series/CPIAUCSL" target="_blank">View full chart on FRED</a>
    </div>

    <div class="fred-card">
      <h3>Core Inflation (ex-Food and Energy)</h3>
      <div class="fred-subtitle">Strips out volatile food and energy prices. This is the number the Fed cares about most.</div>
      <img src="https://fred.stlouisfed.org/graph/fredgraph.png?id=CPILFESL&cosd=2020-01-01&width=400&height=220&bgcolor=%23ffffff&graph_bgcolor=%23ffffff&fo=Open%20Sans&ts=11&tts=11" alt="Core CPI Chart" loading="lazy">
      <a href="https://fred.stlouisfed.org/series/CPILFESL" target="_blank">View full chart on FRED</a>
    </div>

    <div class="fred-card">
      <h3>Unemployment Rate</h3>
      <div class="fred-subtitle">Percentage of people looking for work but not finding it. A strong job market gives the Fed room to raise rates.</div>
      <img src="https://fred.stlouisfed.org/graph/fredgraph.png?id=UNRATE&cosd=2020-01-01&width=400&height=220&bgcolor=%23ffffff&graph_bgcolor=%23ffffff&fo=Open%20Sans&ts=11&tts=11" alt="Unemployment Chart" loading="lazy">
      <a href="https://fred.stlouisfed.org/series/UNRATE" target="_blank">View full chart on FRED</a>
    </div>

    <div class="fred-card">
      <h3>Federal Funds Rate</h3>
      <div class="fred-subtitle">The interest rate the Fed sets. This is the master switch — it ripples through mortgages, car loans, bond yields, and savings rates.</div>
      <img src="https://fred.stlouisfed.org/graph/fredgraph.png?id=FEDFUNDS&cosd=2020-01-01&width=400&height=220&bgcolor=%23ffffff&graph_bgcolor=%23ffffff&fo=Open%20Sans&ts=11&tts=11" alt="Fed Funds Rate Chart" loading="lazy">
      <a href="https://fred.stlouisfed.org/series/FEDFUNDS" target="_blank">View full chart on FRED</a>
    </div>

    <div class="fred-card">
      <h3>10-Year Treasury Yield</h3>
      <div class="fred-subtitle">What the US government pays to borrow money for 10 years. When this rises, stocks often fall and bond values drop.</div>
      <img src="https://fred.stlouisfed.org/graph/fredgraph.png?id=DGS10&cosd=2020-01-01&width=400&height=220&bgcolor=%23ffffff&graph_bgcolor=%23ffffff&fo=Open%20Sans&ts=11&tts=11" alt="10Y Treasury Chart" loading="lazy">
      <a href="https://fred.stlouisfed.org/series/DGS10" target="_blank">View full chart on FRED</a>
    </div>

    <div class="fred-card">
      <h3>Housing Starts</h3>
      <div class="fred-subtitle">New homes being built each month. A leading indicator — when this falls, it signals builders expect slower demand and higher borrowing costs ahead.</div>
      <img src="https://fred.stlouisfed.org/graph/fredgraph.png?id=HOUST&cosd=2020-01-01&width=400&height=220&bgcolor=%23ffffff&graph_bgcolor=%23ffffff&fo=Open%20Sans&ts=11&tts=11" alt="Housing Starts Chart" loading="lazy">
      <a href="https://fred.stlouisfed.org/series/HOUST" target="_blank">View full chart on FRED</a>
    </div>

    <div class="fred-card">
      <h3>30-Year Mortgage Rate</h3>
      <div class="fred-subtitle">What homebuyers pay to borrow. Closely tracks the 10-year Treasury yield. High rates slow housing, which ripples through the broader economy.</div>
      <img src="https://fred.stlouisfed.org/graph/fredgraph.png?id=MORTGAGE30US&cosd=2020-01-01&width=400&height=220&bgcolor=%23ffffff&graph_bgcolor=%23ffffff&fo=Open%20Sans&ts=11&tts=11" alt="Mortgage Rate Chart" loading="lazy">
      <a href="https://fred.stlouisfed.org/series/MORTGAGE30US" target="_blank">View full chart on FRED</a>
    </div>

    <div class="fred-card">
      <h3>US Dollar Index (DXY)</h3>
      <div class="fred-subtitle">Measures the dollar's strength against other currencies. A strong dollar makes US exports more expensive, hurts multinational company profits, and pushes commodity prices down globally.</div>
      <img src="https://fred.stlouisfed.org/graph/fredgraph.png?id=DTWEXBGS&cosd=2020-01-01&width=400&height=220&bgcolor=%23ffffff&graph_bgcolor=%23ffffff&fo=Open%20Sans&ts=11&tts=11" alt="Dollar Index Chart" loading="lazy">
      <a href="https://fred.stlouisfed.org/series/DTWEXBGS" target="_blank">View full chart on FRED</a>
    </div>

  </div>

  <div class="disclaimer">
    Market data is live via TradingView. Economic charts update from the Federal Reserve (FRED) when new data is released.
    This dashboard is for informational purposes only. It is not financial advice. Discuss all investment decisions with your financial advisor.
  </div>

</div>

<script>
  // Expandable watch cards
  function toggleCard(card) {
    const isOpen = card.classList.contains('open');
    // Close all cards first
    document.querySelectorAll('.watch-card').forEach(c => c.classList.remove('open'));
    // If it wasn't open, open it
    if (!isOpen) card.classList.add('open');
  }

  // Live clock
  function updateClock() {
    const now = new Date();
    document.getElementById('clock').innerHTML =
      now.toLocaleDateString('en-US', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) +
      '<br>' + now.toLocaleTimeString('en-US', {hour:'2-digit', minute:'2-digit'});
  }
  updateClock();
  setInterval(updateClock, 30000);
</script>

</body>
</html>
